# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets（API key 一律从 .env 读取，绝不入库）
.env
.env.local

# Windows Zone Identifier 残留（同步 .env 时产生）
*.Zone.Identifier

# 运行产物（前导斜杠锚定仓库根：不带斜杠的 output/ 会连源码包
# src/minimax_h3_prompt/output/ 一起忽略，那三个文件于是从未入库，
# 全新 clone 在 import 阶段就 ModuleNotFoundError）
/output/

# 并行票据工作树（git worktree add worktree/ticket-NN），只登记在 .git/worktrees，
# 目录本身不入库——同 output/ 的教训，锚定仓库根防止误吞源码包
/worktree/
