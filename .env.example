# 复制为 .env 并填入自己的 key。.env 已被 gitignore，绝不入库。
#
# 后端选择：anthropic | openai | dashscope | deepseek
# 不设 LLM_PROVIDER 时会自动探测（DEEPSEEK_* → deepseek，ANTHROPIC_* → anthropic …）
# LLM_PROVIDER=deepseek

# deepseek 后端（DeepSeek 官方 API）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1        # 或用 Anthropic 兼容端点 /anthropic
# DEEPSEEK_MODEL=deepseek-chat

# anthropic 后端（含 DeepSeek 等 Anthropic 兼容端点）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# openai 后端（任意 OpenAI 兼容端点）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# dashscope 后端（阿里云百炼）
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen3.7-max
